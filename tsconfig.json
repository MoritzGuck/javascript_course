{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "isolatedModules": true,
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "jsx": "react-jsx"
  },
  "include": [
    "tech_history_timeline/**/*",
    "tech_history_timeline_react/**/*",
    "vite.config.ts",
    "vite.config.react.ts",
    "svelte.config.js"
  ]
}
